# Gestor de base de datos: MYSQL o H2
database.engine=MYSQL
# Forma de obtener conexiones: DRIVER_MANAGER o POOL
connection.mode=DRIVER_MANAGER
# Tipo de simulacion: NORMAL o FALLO_TRANSACCION
simulation.mode=NORMAL
#Base de datos mysql
mysql.url=jdbc:mysql://localhost:3306/unidad2?createDatabaseIfNotExist=true
mysql.user=root
mysql.password=CAMBIAR_AQUI
#H2 configuracion
h2.url=jdbc:h2:./data/unidad2;MODE=MySQL;DATABASE_TO_LOWER=TRUE
h2.user=sa
h2.password=

# Parametros del pool HikariCP
pool.maxSize=5
pool.connectionTimeoutMs=10000